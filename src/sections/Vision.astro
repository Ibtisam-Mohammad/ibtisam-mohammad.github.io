---
// §10.4 — Computer vision, SIGNATURE 2 of 4. The turtle performs the bounding-box
// image reveal (§8 variant 1) on the lead image: draws wobbled boxes, stamps mono
// label chips, the image appears inside the box then expands, and a segmentation
// tint scrubs 0 → 30% → 0 with scroll. A pose skeleton draws over the second image
// (desktop; mobile keeps the box reveal and drops the skeleton, §10).
import SectionHeader from '../components/SectionHeader.astro';
import { mulberry32, wobbleRect } from '../lib/draw.mjs';

const rand = mulberry32(20260714);

// Selected work from the resume and public GitHub projects.
const projects = [
  {
    name: 'Multi-stream CCTV security',
    line: 'A FastAPI detection service using YOLOv11 and DETR across concurrent camera streams, integrated with plate, face, and mask recognition.',
    chips: ['detection', 'streaming', 'FastAPI'],
  },
  {
    name: 'Pose from partial bodies',
    line: 'RTMPose fine-tuned to recover full-body keypoints, including hands and limbs, from partial-body inputs; paired with SAM garment segmentation.',
    chips: ['pose estimation', 'fine-tuning'],
  },
  {
    name: 'Vehicle wait-time detection',
    line: 'A public detection and tracking pipeline that measures vehicle dwell time inside a predefined region of interest.',
    chips: ['tracking', 'open source'],
    href: 'https://github.com/Ibtisam-Mohammad/Vehicle_Wait_Time_Detector',
  },
];

// detections in cv-scene.webp coordinates (1280x853): the defect, then a healthy part
const BOX1 = { x: 596, y: 352, w: 214, h: 172, label: 'object 0.97' };
const BOX2 = { x: 136, y: 414, w: 330, h: 202, label: 'part 0.88' };
const BOX3 = { x: 930, y: 418, w: 224, h: 164, label: 'part 0.58' };
const box1D = wobbleRect(BOX1.x, BOX1.y, BOX1.w, BOX1.h, rand, { step: 46, amp: 5 });
const box2D = wobbleRect(BOX2.x, BOX2.y, BOX2.w, BOX2.h, rand, { step: 52, amp: 5 });
const box3D = wobbleRect(BOX3.x, BOX3.y, BOX3.w, BOX3.h, rand, { step: 44, amp: 4 });
// clip-path insets for "the image appears inside the box" (fractions of the frame)
const clip1 = {
  top: ((BOX1.y / 853) * 100).toFixed(2),
  right: (((1280 - BOX1.x - BOX1.w) / 1280) * 100).toFixed(2),
  bottom: (((853 - BOX1.y - BOX1.h) / 853) * 100).toFixed(2),
  left: ((BOX1.x / 1280) * 100).toFixed(2),
};

// pose skeleton joints (cv-pose.webp coordinates, 1000x750) — matches the figure
const J = {
  head: [505, 148], neck: [500, 210], hip: [490, 385],
  kneeF: [560, 480], footF: [600, 585], kneeB: [420, 490], footB: [365, 590],
  elbF: [585, 300], handF: [620, 370], elbB: [415, 295], handB: [385, 360],
};
const bones: [string, string][] = [
  ['neck', 'hip'], ['neck', 'elbF'], ['elbF', 'handF'], ['neck', 'elbB'], ['elbB', 'handB'],
  ['hip', 'kneeF'], ['kneeF', 'footF'], ['hip', 'kneeB'], ['kneeB', 'footB'],
];
---
<section id="vision" class="section" style="--accent: var(--leaf)" aria-labelledby="vision-title">
  <div class="container">
    <SectionHeader
      num="04"
      title="Computer vision"
      headingId="vision-title"
      glyphId="vision"
      lede="Systems that measure the physical world through cameras — built for real lighting, real occlusion, and real deadlines."
    />

    <div class="cv-grid">
      <figure class="cv-figure-wrap">
        <div class="cv-figure" style={`--clip1: inset(${clip1.top}% ${clip1.right}% ${clip1.bottom}% ${clip1.left}%);`}>
          <img
            class="cv-img"
            src="/img/cv-scene.webp"
            alt="Stylized conveyor scene with three object-detection proposals and confidence labels"
            width="1280" height="853" loading="lazy" decoding="async"
          />
          <div class="cv-seg" aria-hidden="true"></div>
          <svg class="cv-overlay" viewBox="0 0 1280 853" preserveAspectRatio="none" aria-hidden="true">
            <g class="cv-detection" data-confidence="0.97">
              <path data-draw class="cv-box" d={box1D} />
              <g class="cv-chip" data-chip="1">
                <rect x={BOX1.x} y={BOX1.y - 44} width="200" height="38" rx="6" />
                <text x={BOX1.x + 14} y={BOX1.y - 17}>{BOX1.label}</text>
              </g>
            </g>
            <g class="cv-detection" data-confidence="0.88">
              <path data-draw class="cv-box cv-box-2" d={box2D} />
              <g class="cv-chip" data-chip="2">
                <rect x={BOX2.x} y={BOX2.y - 44} width="152" height="38" rx="6" />
                <text x={BOX2.x + 14} y={BOX2.y - 17}>{BOX2.label}</text>
              </g>
            </g>
            <g class="cv-detection is-filtered" data-confidence="0.58">
              <path data-draw class="cv-box cv-box-3" d={box3D} />
              <g class="cv-chip" data-chip="3">
                <rect x={BOX3.x} y={BOX3.y - 44} width="152" height="38" rx="6" />
                <text x={BOX3.x + 14} y={BOX3.y - 17}>{BOX3.label}</text>
              </g>
            </g>
          </svg>
        </div>
        <div class="threshold-tool" data-detection-threshold>
          <label class="mono" for="confidence-threshold">
            confidence threshold <output data-threshold-value>0.70</output>
          </label>
          <input id="confidence-threshold" data-threshold-input type="range" min="0.35" max="0.99" step="0.01" value="0.70" disabled />
          <output class="mono threshold-result" data-threshold-result aria-live="polite">2 of 3 proposals retained</output>
        </div>
        <figcaption class="mono muted">Object-detection study · illustrative scene; client footage remains private.</figcaption>
      </figure>

      <figure class="cv-pose-wrap">
        <div class="cv-pose">
          <img
            src="/img/cv-pose.webp"
            alt="Stylized walking figure with a full-body pose skeleton and keypoints"
            width="1000" height="750" loading="lazy" decoding="async"
          />
          <svg class="pose-svg" viewBox="0 0 1000 750" preserveAspectRatio="none" aria-hidden="true">
            <circle data-draw class="pose-head" cx={J.head[0]} cy={J.head[1]} r="42" />
            {bones.map(([a, b]) => (
              <path data-draw class="pose-bone" d={`M ${J[a][0]} ${J[a][1]} L ${J[b][0]} ${J[b][1]}`} />
            ))}
            {Object.values(J).map(([x, y]) => <circle data-pop class="pose-joint" cx={x} cy={y} r="8" />)}
          </svg>
        </div>
        <figcaption class="mono muted">Full-body keypoint reconstruction · illustrative scene.</figcaption>
      </figure>
    </div>

    <ul class="cols-3 project-grid" role="list">
      {projects.map((p) => (
        <li class="card">
          <h3>{p.name}</h3>
          <p class="proj-line">{p.line}</p>
          <ul class="chip-row" role="list">
            {p.chips.map((c) => <li class="chip">{c}</li>)}
          </ul>
          {p.href && <p class="mono proj-link"><a href={p.href}>view the repo →</a></p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cv-grid {
    display: grid;
    gap: var(--s-5);
    margin-block: var(--s-6);
  }
  @media (min-width: 1024px) {
    .cv-grid { grid-template-columns: 3fr 2fr; align-items: start; }
  }
  .cv-figure, .cv-pose {
    position: relative;
    border-radius: var(--radius-lg);
    background: var(--paper-deep);
    overflow: hidden;
  }
  .cv-figure img, .cv-pose img { width: 100%; height: auto; display: block; }
  /* finished state: full image visible; the engine scrubs from --clip1 to none */
  .cv-img { clip-path: none; }
  .cv-seg {
    position: absolute;
    inset: 0;
    background: var(--leaf);
    mask-image: url(/img/cv-seg.webp);
    mask-size: 100% 100%;
    -webkit-mask-image: url(/img/cv-seg.webp);
    -webkit-mask-size: 100% 100%;
    opacity: 0; /* finished state: tint off (it scrubs 0 -> 30% -> 0 mid-scene) */
    pointer-events: none;
  }
  .cv-overlay, .pose-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .cv-box { stroke: var(--leaf); stroke-width: 4.5; fill: none; stroke-linejoin: round; }
  .cv-box-2 { stroke: var(--teal); }
  .cv-box-3 { stroke: var(--ink-soft); }
  .cv-chip rect { fill: var(--leaf); }
  .cv-chip[data-chip="2"] rect { fill: var(--teal); }
  .cv-chip[data-chip="3"] rect { fill: var(--ink-soft); }
  .cv-chip text {
    font-family: var(--font-mono);
    font-size: 26px;
    letter-spacing: 0.04em;
    fill: var(--paper);
  }
  .cv-detection {
    opacity: 1;
    transition: opacity var(--t-fast) var(--ease);
  }
  .cv-detection.is-filtered { opacity: 0.14; }
  .cv-detection.is-filtered .cv-box { stroke-dasharray: 12 10; }
  .threshold-tool {
    display: grid;
    grid-template-columns: auto minmax(130px, 1fr) auto;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-3);
    padding-block: var(--s-3);
    border-block: 1px solid var(--line);
  }
  .threshold-tool label,
  .threshold-result { color: var(--ink-soft); }
  .threshold-tool input { width: 100%; accent-color: var(--leaf); }
  .threshold-result { text-align: right; }
  .pose-head, .pose-bone { stroke: var(--leaf); stroke-width: 5; fill: none; stroke-linecap: round; }
  .pose-joint { fill: var(--cobalt); }
  @media (max-width: 719px) {
    /* mobile keeps the bounding-box reveal, drops the skeleton (§10.4) */
    .pose-svg { display: none; }
    .threshold-tool { grid-template-columns: 1fr; gap: var(--s-2); }
    .threshold-result { text-align: left; }
  }

  .project-grid { margin-top: var(--s-6); padding: 0; list-style: none; }
  .card h3 { margin-bottom: var(--s-3); }
  .proj-line { margin-bottom: var(--s-4); }
  .card .chip-row { margin-bottom: var(--s-4); }
  .proj-link { font-size: var(--step--1); }
</style>
