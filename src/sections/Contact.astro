---
// §10.9 — Contact & résumé, SIGNATURE 4 of 4: the fully painted turtle draws the
// site's only hand-lettered element, and the page's conversion block lives here —
// explicit availability, a copy-able email, and every link a buyer needs.
import SectionHeader from '../components/SectionHeader.astro';
---
<section id="contact" class="section" style="--accent: var(--ink-soft)" aria-labelledby="contact-title">
  <div class="container">
    <SectionHeader
      num="09"
      title="Contact"
      headingId="contact-title"
      glyphId="contact"
      lede="I like problems where the math has to be right and the system has to ship. If you have one, I would like to hear about it."
    />
    <!-- SIGNATURE 4 of 4: the fully painted turtle draws the site's only
         hand-lettered element. -->
    <div class="signature-wrap" aria-hidden="true">
      <svg class="signature" viewBox="0 0 300 100">
        <path data-draw class="sig-main" d="M 18 66 C 10 40, 30 18, 48 24 C 68 31, 64 60, 46 68 C 32 74, 20 64, 24 52 C 28 40, 44 40, 56 44 C 84 53, 96 30, 116 30 C 128 30, 124 48, 138 46 C 150 44, 152 28, 166 30 C 178 32, 176 50, 190 48 C 206 45, 210 26, 226 30 C 240 34, 236 52, 252 50 C 268 48, 274 36, 286 38" />
        <path data-draw class="sig-under" d="M 44 84 C 100 76, 180 74, 250 66" />
        <circle data-pop class="sig-dot" cx="262" cy="30" r="3.4" />
      </svg>
    </div>

    <!-- what is actually for sale: stated plainly, near the actions -->
    <p class="avail-note" data-vine-exclude>
      <span class="avail-dot" aria-hidden="true"></span>
      I take <strong>contract engagements</strong> — computer vision, generative AI, and
      MLOps systems — and I am <strong>open to full-time roles</strong>. Remote-first
      from UTC+05:30, and I keep hours that overlap wherever the team is: US east or
      west, Europe, Australia, Japan.
    </p>

    <div class="contact-actions" data-vine-exclude>
      <a class="btn btn-primary" href="mailto:ibtisam115@gmail.com">Email me</a>
      <a class="btn btn-ghost" href="/resume.pdf" target="_blank" rel="noopener">View résumé</a>
      <p class="mono muted">PDF · two pages</p>
    </div>
    <ul class="contact-links" role="list" data-vine-exclude>
      <li class="mono">
        <span class="muted">Email&nbsp;&nbsp;·</span>
        <a href="mailto:ibtisam115@gmail.com">ibtisam115@gmail.com</a>
        <button type="button" class="copy-email mono" data-copy-email="ibtisam115@gmail.com" hidden>copy</button>
      </li>
      <li class="mono"><span class="muted">GitHub&nbsp;&nbsp;·</span> <a href="https://github.com/Ibtisam-Mohammad">github.com/Ibtisam-Mohammad</a></li>
      <li class="mono"><span class="muted">LinkedIn&nbsp;&nbsp;·</span> <a href="https://www.linkedin.com/in/ibtim/">linkedin.com/in/ibtim</a></li>
      <li class="mono"><span class="muted">Notes&nbsp;&nbsp;·</span> <a href="/#notes">field notes, hosted on this site</a></li>
    </ul>
    <p class="mono muted location" data-vine-exclude>Ibtisam Mohammad · Srinagar, Jammu &amp; Kashmir, India · UTC+05:30</p>
  </div>
</section>

<script>
  // copy-to-clipboard fallback for machines without a mail client — the most common
  // silent failure of mailto links on corporate hardware. JS-gated: hidden otherwise.
  for (const btn of document.querySelectorAll('[data-copy-email]')) {
    const b = btn as HTMLButtonElement;
    if (!navigator.clipboard) continue;
    b.hidden = false;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copyEmail || '');
        const prev = b.textContent;
        b.textContent = 'copied ✓';
        b.classList.add('copied');
        setTimeout(() => {
          b.textContent = prev;
          b.classList.remove('copied');
        }, 1600);
      } catch {
        /* clipboard denied: the address is still selectable text */
      }
    });
  }
</script>

<style>
  /* settled full palette (plan.md §7 arc) */
  #contact :global(.kicker-dot) {
    width: 34px;
    background: linear-gradient(90deg, var(--cobalt), var(--teal), var(--leaf), var(--violet), var(--ember));
  }
  .signature-wrap { margin-top: var(--s-6); }
  .signature { width: min(280px, 70%); height: auto; overflow: visible; }
  .sig-main, .sig-under {
    stroke: var(--ink);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sig-main { stroke-width: 2.6; }
  .sig-under { stroke-width: 1.8; opacity: 0.75; }
  .sig-dot { fill: var(--ink); }

  .avail-note {
    margin-top: var(--s-5);
    max-width: 58ch;
  }
  .avail-note strong { font-weight: 600; }
  .avail-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--leaf) 18%, transparent);
  }

  .contact-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-block: var(--s-5) var(--s-6);
  }
  .contact-links {
    display: grid;
    gap: var(--s-3);
    padding: 0;
    list-style: none;
  }
  .copy-email {
    margin-left: var(--s-2);
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--ink-soft);
    font-size: var(--step--1);
    cursor: pointer;
    transition: border-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .copy-email:hover { border-color: var(--ink-soft); color: var(--ink); }
  .copy-email.copied { border-color: var(--leaf); color: var(--leaf-text); }
  .location { margin-top: var(--s-6); }
</style>
