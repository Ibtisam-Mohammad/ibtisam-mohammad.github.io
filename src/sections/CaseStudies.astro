---
// §10.7 — Selected case studies: the 30-second recruiter skim zone.
// Strict template: Problem → Approach → Result → stack → link, now with taped-frame
// screenshot reveals (§8 variant 3: the turtle draws a frame plus two tape corners;
// the screenshot fades in immediately — calm and instant) and connective arrows
// Problem → Approach → Result on every card (built at runtime in sections.js).
import SectionHeader from '../components/SectionHeader.astro';
import { BOOKING, BOOKING_LABEL, EMAIL_HREF, RESUME } from '../data/contact';
import { mulberry32, wobbleRect } from '../lib/draw.mjs';

const rand = mulberry32(20260715);

// Resume-backed client work. Illustrations are privacy-safe reconstructions, not screenshots.
const cases = [
  {
    name: 'Multi-stream video security service',
    problem: 'A camera-security product needed real-time detection across multiple CCTV streams while combining plate, face, and mask recognition under production load.',
    approach: 'Built a FastAPI microservice around YOLOv11 and DETR, integrated the recognition services, and added DINO-embedding checks for camera movement and obstruction. Instrumented every hop before touching config, then reworked Nginx and service concurrency around the measured bottlenecks — the same define-measure-test discipline physics trains.',
    result: 'Reduced API latency from roughly 25 seconds to under one second and cut server errors by 95% under high load.',
    resultChips: ['~25 s → <1 s', '−95% errors'],
    stack: ['FastAPI', 'YOLOv11', 'DETR', 'DINO', 'Nginx'],
    shot: '/img/shot-detection.webp',
    shotAlt: 'Illustrated video analytics dashboard with detection boxes, charts, and service metrics',
    availability: 'DwarfAI · 2024–25',
  },
  {
    name: 'AI assistant for Microsoft Project',
    problem: 'Project teams needed natural-language analysis over live schedules without losing the structure of tasks, dependencies, Gantt workflows, and MPP or XML files.',
    approach: 'Built a full-stack Microsoft Project add-in with Office.js, authenticated FastAPI endpoints, MongoDB, streaming chat, file handling, schedule reasoning, observability, graph-based evaluation, and end-to-end tests.',
    result: 'Delivered an integrated assistant that analyzes live schedule context, handles MPP and XML project files, and supports conversational task and Gantt workflows inside Microsoft Project.',
    resultChips: ['full-stack add-in', 'evaluated workflows'],
    stack: ['Office.js', 'FastAPI', 'MongoDB', 'LLM services'],
    shot: '/img/shot-assistant.webp',
    shotAlt: 'Illustrated project assistant interface with a task list and contextual chat',
    availability: 'DwarfAI · 2024–25',
  },
  {
    name: 'Campaign orchestrator with LLM drafting',
    problem: 'Building a multi-step outreach campaign meant hand-writing every email and SMS, wiring the audience, and stitching results across tools — hours of work per campaign.',
    approach: 'Built a full-stack platform: LLM services draft the campaign from one description, review the sequence, and assist live operations; background workers handle audience sync, scheduled SendGrid and Twilio dispatch, and CRM writeback through an outbox; registration webhooks attribute sign-ups back to the exact send.',
    result: 'Campaign creation went from hours of manual work to minutes — draft, review, launch, and tracked registrations on one platform.',
    resultChips: ['hours → minutes', 'draft to tracked sign-ups'],
    stack: ['ASP.NET Core', 'React', 'SQL Server', 'SendGrid', 'Twilio'],
    shot: '/img/shot-pipeline.webp',
    shotAlt: 'Illustrated campaign platform with workflow stages, delivery chart, and status rows',
    availability: 'Vikara AI · 2026',
  },
];

// each card gets its own wobbled frame + two tape corners
const frames = cases.map(() => wobbleRect(6, 6, 508, 318, rand, { step: 44, amp: 4 }));
const TAPE_TL = 'M -20 34 L 34 -20 L 58 4 L 4 58 Z';
const TAPE_BR = 'M 462 344 L 516 290 L 540 314 L 486 368 Z';
---
<section id="work" class="section" style="--accent: var(--ink-soft)" aria-labelledby="work-title">
  <div class="container">
    <SectionHeader
      num="07"
      title="Selected case studies"
      headingId="work-title"
      glyphId="work"
      lede="Three shipped systems: problem, approach, result."
    />
    <div class="case-list">
      {cases.map((c, i) => (
        <article class="card cs-card">
          <header class="cs-head">
            <h3>{c.name}</h3>
            <span class="mono muted cs-availability">{c.availability}</span>
          </header>
          <dl class="cs-rows">
            <div class="cs-row">
              <dt class="mono muted">Problem</dt>
              <dd>{c.problem}</dd>
            </div>
            <div class="cs-row">
              <dt class="mono muted">Approach</dt>
              <dd>{c.approach}</dd>
            </div>
            <div class="cs-row">
              <dt class="mono muted">Result</dt>
              <dd>
                <p class="cs-result">{c.result}</p>
                <ul class="chip-row" role="list">
                  {c.resultChips.map((r) => <li class="chip">{r}</li>)}
                </ul>
              </dd>
            </div>
            <div class="cs-row">
              <dt class="mono muted">Stack</dt>
              <dd>
                <ul class="chip-row" role="list">
                  {c.stack.map((s) => <li class="chip cs-stack-chip">{s}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
          <figure class="cs-shot">
            <div class="cs-shot-frame">
              <img src={c.shot} alt={c.shotAlt} width="1200" height="750" loading="lazy" decoding="async" />
              <svg class="cs-frame-svg" viewBox="0 0 520 330" preserveAspectRatio="none" aria-hidden="true">
                <path data-draw class="cs-frame-path" d={frames[i]} />
                <path data-pop class="cs-tape" d={TAPE_TL} />
                <path data-pop class="cs-tape" d={TAPE_BR} />
              </svg>
            </div>
          </figure>
        </article>
      ))}
    </div>
    <!-- peak buying intent lives right here, after the results -->
    <div class="cs-cta" data-vine-exclude>
      <p class="cs-cta-line">Need results like these on your system?</p>
      <div class="cs-cta-actions">
        {BOOKING && <a class="btn btn-primary" href={BOOKING} target="_blank" rel="noopener">{BOOKING_LABEL}</a>}
        <a class={BOOKING ? 'btn btn-ghost' : 'btn btn-primary'} href={EMAIL_HREF}>Email me</a>
        <a class="btn btn-ghost" href={RESUME} target="_blank" rel="noopener">View résumé</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* full palette, structured, calm: the kicker dot becomes the collected-palette strip */
  #work :global(.kicker-dot) {
    width: 34px;
    background: linear-gradient(90deg, var(--cobalt), var(--teal), var(--leaf), var(--violet), var(--ember));
  }
  .case-list { display: grid; gap: var(--s-5); }
  .cs-card { padding: var(--s-6); }
  @media (min-width: 1024px) {
    .cs-card {
      display: grid;
      grid-template-columns: 1fr 340px;
      column-gap: var(--s-6);
      align-items: start;
    }
    .cs-head, .cs-link { grid-column: 1 / -1; }
  }
  .cs-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
  .cs-availability { white-space: nowrap; }
  .cs-rows { display: grid; gap: var(--s-4); margin: 0; }
  .cs-row {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
  }
  .cs-row dt { letter-spacing: 0.08em; }
  .cs-row dd { margin: 0; }
  .cs-result { font-weight: 600; margin-bottom: var(--s-2); }
  .cs-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-6);
    padding: var(--s-5) var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper-deep);
  }
  .cs-cta-line {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
  }
  .cs-cta-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (max-width: 719px) {
    .cs-head { align-items: flex-start; flex-direction: column; gap: var(--s-2); }
    .cs-availability { white-space: normal; }
    .cs-row { grid-template-columns: 1fr; }
  }

  .cs-shot { margin-top: var(--s-5); }
  @media (min-width: 1024px) {
    .cs-shot { margin-top: 0; }
  }
  .cs-shot-frame { position: relative; }
  .cs-shot-frame img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
  }
  .cs-frame-svg {
    position: absolute;
    inset: -8px;
    width: calc(100% + 16px);
    height: calc(100% + 16px);
    overflow: visible;
    pointer-events: none;
  }
  .cs-frame-path { stroke: var(--ink); stroke-width: 2; fill: none; stroke-linejoin: round; }
  .cs-tape {
    fill: var(--marker);
    fill-opacity: 0.5;
    stroke: color-mix(in srgb, var(--ink) 30%, transparent);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
