---
// §10.6 — Production MLOps: "color, disciplined". Static pipeline diagram (the finished state
// that Phase 3 animates as a turtle drawing) + placeholder stat chips, clearly marked.
import SectionHeader from '../components/SectionHeader.astro';
---
<section id="mlops" class="section" style="--accent: var(--ember)" aria-labelledby="mlops-title">
  <div class="container">
    <SectionHeader
      num="06"
      title="MLOps &amp; production"
      headingId="mlops-title"
      glyphId="mlops"
      lede="A model is a liability until it is deployed, observed, and cheap to retrain. I build the part that makes it an asset."
    />
    <div class="prose">
      <p>
        Pipelines, registries, monitoring — and the discipline to roll back. The palette
        collected above gets contained here: color inside the shapes, nothing loose.
      </p>
    </div>

    <figure class="pipeline-fig">
      <p class="visually-hidden">
        Pipeline diagram: five stages connected by arrows — data, train, registry, deploy,
        monitor. The monitor stage carries a small latency sparkline.
      </p>
      <svg class="pipeline pipeline-h" viewBox="0 0 768 128" aria-hidden="true">
        <defs>
          <marker id="arr-h" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path class="pl-arrow" d="M0 0 L8 4 L0 8 Z" />
          </marker>
        </defs>
        <g class="pl-connectors">
          <path data-draw d="M128 64 H156" marker-end="url(#arr-h)" />
          <path data-draw d="M288 64 H316" marker-end="url(#arr-h)" />
          <path data-draw d="M448 64 H476" marker-end="url(#arr-h)" />
          <path data-draw d="M608 64 H636" marker-end="url(#arr-h)" />
        </g>
        <g>
          <rect data-draw class="pl-node" x="4" y="40" width="120" height="48" rx="10" fill="#2B59C3" />
          <text class="pl-label" x="64" y="64">data</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="164" y="40" width="120" height="48" rx="10" fill="#0E8A78" />
          <text class="pl-label" x="224" y="64">train</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="324" y="40" width="120" height="48" rx="10" fill="#4E9B35" />
          <text class="pl-label" x="384" y="64">registry</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="484" y="40" width="120" height="48" rx="10" fill="#7A4FD6" />
          <text class="pl-label" x="544" y="64">deploy</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="644" y="40" width="120" height="48" rx="10" fill="#E0731D" />
          <text class="pl-label" x="704" y="56">monitor</text>
          <polyline data-draw class="pl-spark" points="656,78 668,72 680,76 692,69 704,74 716,67 728,71 740,68" />
        </g>
      </svg>
      <svg class="pipeline pipeline-v" viewBox="0 0 240 560" aria-hidden="true">
        <defs>
          <marker id="arr-v" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path class="pl-arrow" d="M0 0 L8 4 L0 8 Z" />
          </marker>
        </defs>
        <g class="pl-connectors">
          <path data-draw d="M120 70 V110" marker-end="url(#arr-v)" />
          <path data-draw d="M120 182 V222" marker-end="url(#arr-v)" />
          <path data-draw d="M120 294 V334" marker-end="url(#arr-v)" />
          <path data-draw d="M120 406 V446" marker-end="url(#arr-v)" />
        </g>
        <g>
          <rect data-draw class="pl-node" x="20" y="4" width="200" height="64" rx="10" fill="#2B59C3" />
          <text class="pl-label" x="120" y="36">data</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="20" y="116" width="200" height="64" rx="10" fill="#0E8A78" />
          <text class="pl-label" x="120" y="148">train</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="20" y="228" width="200" height="64" rx="10" fill="#4E9B35" />
          <text class="pl-label" x="120" y="260">registry</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="20" y="340" width="200" height="64" rx="10" fill="#7A4FD6" />
          <text class="pl-label" x="120" y="372">deploy</text>
        </g>
        <g>
          <rect data-draw class="pl-node" x="20" y="452" width="200" height="64" rx="10" fill="#E0731D" />
          <text class="pl-label" x="120" y="478">monitor</text>
          <polyline data-draw class="pl-spark" points="44,504 64,498 84,502 104,495 124,500 144,493 164,497 184,494" />
        </g>
      </svg>
      <figcaption class="mono muted">data → train → registry → deploy → monitor.</figcaption>
    </figure>

    <ul class="stat-row" role="list">
      <li class="stat">
        <span class="stat-num">38 ms</span>
        <span class="stat-bar" aria-hidden="true"></span>
        <span class="stat-label">p95 inference latency</span>
      </li>
      <li class="stat">
        <span class="stat-num">99.95%</span>
        <span class="stat-bar" aria-hidden="true"></span>
        <span class="stat-label">serving uptime</span>
      </li>
      <li class="stat">
        <span class="stat-num">14</span>
        <span class="stat-bar" aria-hidden="true"></span>
        <span class="stat-label">models in production</span>
      </li>
    </ul>
    <!-- PLACEHOLDER: metrics above are illustrative, not claims -->
    <p class="mono muted stat-note"><span class="placeholder-tag">placeholder metrics</span> replaced by real production numbers.</p>
  </div>
</section>

<style>
  .pipeline-fig { margin-block: var(--s-6); }
  .pipeline-fig figcaption { margin-top: var(--s-3); }
  .pipeline { width: 100%; height: auto; }
  .pipeline-h { display: none; }
  @media (min-width: 720px) {
    .pipeline-h { display: block; }
    .pipeline-v { display: none; }
  }
  .pipeline-v { max-width: 320px; margin-inline: auto; }

  /* color, disciplined: palette lives inside the node shapes at wash opacity */
  .pl-node { fill-opacity: 0.16; stroke: var(--ink); stroke-width: 2; }
  .pl-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .pl-connectors path { stroke: var(--ink); stroke-width: 1.5; fill: none; }
  .pl-arrow { fill: var(--ink); }
  .pl-spark { fill: none; stroke: var(--ember); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .stat-row { margin-top: var(--s-7); }
  .stat-note { margin-top: var(--s-4); }
</style>
