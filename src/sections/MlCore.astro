---
// §10.3 — AI / ML expertise: short narrative + grouped skill chips, plus the turtle's
// three drawings: a small feed-forward network (3-4-2), a decision boundary curving
// between two point clouds, and an embedding scatter with two hulls. Geometry is
// generated at build time; the engine draws it on scroll.
import SectionHeader from '../components/SectionHeader.astro';
import { mulberry32, wobbleEllipse, scatter } from '../lib/draw.mjs';

const rand = mulberry32(20260713);

const groups = [
  {
    name: 'Vision & generative models',
    skills: ['YOLOv11', 'DETR', 'SAM', 'DINO', 'RTMPose', 'Stable Diffusion', 'ControlNet'],
  },
  {
    name: 'LLM systems & evaluation',
    skills: ['LangGraph', 'Langfuse', 'DeepEval', 'Sentence-Transformers'],
  },
  {
    name: 'Backend & infrastructure',
    skills: ['Python', 'FastAPI', 'MongoDB', 'Docker', 'AWS', 'Nginx', 'Linux'],
  },
  {
    name: 'ML lifecycle',
    skills: ['TensorFlow', 'scikit-learn', 'DVC', 'MLflow', 'CVAT', 'CI/CD'],
  },
];

// panel 1: feed-forward network, 3-4-2
const layers = [
  [86, 140, 194].map((y) => [80, y]),
  [59, 113, 167, 221].map((y) => [180, y]),
  [113, 167].map((y) => [280, y]),
] as [number, number][][];
const edges: string[] = [];
for (let l = 0; l < layers.length - 1; l++) {
  for (const [x1, y1] of layers[l]) {
    for (const [x2, y2] of layers[l + 1]) {
      edges.push(`M ${x1 + 13} ${y1} L ${x2 - 13} ${y2}`);
    }
  }
}
const nodes = layers.flat();

// panel 2: two clouds and the boundary between them
const cloudA = scatter(468, 105, 30, 26, 12, rand);
const cloudB = scatter(566, 196, 30, 24, 12, rand);
const boundaryD = 'M 392 236 C 452 214, 462 118, 520 142 C 566 161, 592 84, 648 68';

// panel 3: embedding scatter with two hulls
const embA = scatter(772, 112, 34, 20, 10, rand, -0.3);
const embB = scatter(888, 198, 30, 22, 10, rand, 0.2);
const hullA = wobbleEllipse(772, 112, 62, 38, rand, { wobble: 0.06, rot: -0.3 });
const hullB = wobbleEllipse(888, 198, 56, 40, rand, { wobble: 0.06, rot: 0.2 });
---
<section id="ml" class="section" style="--accent: var(--teal)" aria-labelledby="ml-title">
  <div class="container">
    <SectionHeader
      num="03"
      title="AI &amp; machine learning"
      headingId="ml-title"
      glyphId="ml"
      lede="Models, evaluation, APIs, and infrastructure: the full path from an experiment to a working product."
    />
    <div class="prose">
      <p>
        Since 2023, I have worked across production computer vision, generative AI, and
        LLM products. The job rarely ends at model quality: it also includes data tooling,
        evaluation, authenticated APIs, queues, reverse proxies, observability, and cost.
      </p>
    </div>

    <figure class="ml-scene-wrap">
      <svg class="ml-scene" viewBox="0 0 1000 280" aria-hidden="true">
        <!-- feed-forward net -->
        {edges.map((d) => <path data-draw class="net-edge" d={d} />)}
        {nodes.map(([x, y]) => <circle data-pop class="net-node" cx={x} cy={y} r="13" />)}
        <!-- decision boundary -->
        {cloudA.map(([x, y]) => <circle data-pop class="dot-a" cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5" />)}
        {cloudB.map(([x, y]) => <circle data-pop class="dot-b" cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5" />)}
        <path data-draw class="boundary" d={boundaryD} />
        <!-- embedding hulls -->
        {embA.map(([x, y]) => <circle data-pop class="dot-a" cx={x.toFixed(1)} cy={y.toFixed(1)} r="3.5" />)}
        {embB.map(([x, y]) => <circle data-pop class="dot-b" cx={x.toFixed(1)} cy={y.toFixed(1)} r="3.5" />)}
        <path data-draw class="hull" d={hullA} />
        <path data-draw class="hull hull-b" d={hullB} />
      </svg>
      <figcaption class="visually-hidden">
        Three sketches: a small feed-forward network, a decision boundary between two point
        clouds, and an embedding scatter enclosed by two hulls.
      </figcaption>
    </figure>

    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3>{g.name}</h3>
          <ul class="chip-row" role="list">
            {g.skills.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="experience">
      <h3>Experience</h3>
      <ol class="experience-list" role="list">
        <li>
          <p><strong>AI Consultant · Vikara AI</strong><span class="mono muted">Jan 2026 — present</span></p>
          <p class="muted">Consulting on LLM-driven campaign management, messaging automation, CRM workflows, and AI-assisted class rescheduling.</p>
        </li>
        <li>
          <p><strong>Machine Learning Engineer · DwarfAI</strong><span class="mono muted">Sep 2024 — Dec 2025</span></p>
          <p class="muted">Built computer-vision services, continuous model workflows, LLM evaluation systems, and a full-stack AI assistant for Microsoft Project.</p>
        </li>
        <li>
          <p><strong>Machine Learning Engineer / Founding Engineer · DressmeAI</strong><span class="mono muted">Apr 2023 — Sep 2024</span></p>
          <p class="muted">Shipped virtual try-on, garment segmentation, pose estimation, face swap, and scalable diffusion infrastructure.</p>
        </li>
        <li>
          <p><strong>AI Consultant · Univ.AI</strong><span class="mono muted">Feb 2023 — Jul 2023</span></p>
          <p class="muted">Developed a reproducible finance ML pipeline using DVC, Poetry, Docker, and scalable deployment practices.</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .ml-scene-wrap { margin-block: var(--s-6) var(--s-5); }
  .ml-scene { width: 100%; height: auto; overflow: visible; }
  .net-edge { stroke: var(--ink-soft); stroke-width: 1.2; fill: none; opacity: 0.55; }
  .net-node { fill: color-mix(in srgb, var(--teal) 22%, var(--paper)); stroke: var(--ink); stroke-width: 1.75; }
  .dot-a { fill: var(--teal); }
  .dot-b { fill: var(--ink-soft); }
  .boundary { stroke: var(--ink); stroke-width: 2.25; fill: none; stroke-linecap: round; }
  .hull { stroke: var(--teal); stroke-width: 1.75; fill: color-mix(in srgb, var(--teal) 8%, transparent); }
  .hull-b { stroke: var(--ink-soft); fill: color-mix(in srgb, var(--ink-soft) 7%, transparent); }

  .groups { margin-top: var(--s-6); display: grid; gap: var(--s-6); }
  .group h3 { font-size: 1.0625rem; font-weight: 500; margin-bottom: var(--s-3); }
  .experience { margin-top: var(--s-8); }
  .experience > h3 { margin-bottom: var(--s-4); }
  .experience-list { padding: 0; list-style: none; border-top: 1px solid var(--line-soft); }
  .experience-list li { padding-block: var(--s-4); border-bottom: 1px solid var(--line-soft); }
  .experience-list li > p:first-child {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    align-items: baseline;
  }
  .experience-list li > p + p { margin-top: var(--s-2); max-width: 72ch; }
  @media (max-width: 719px) {
    .experience-list li > p:first-child { display: grid; gap: var(--s-1); }
  }
</style>
