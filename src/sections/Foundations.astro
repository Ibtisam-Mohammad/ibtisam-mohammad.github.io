---
// §10.2 — Physics & math foundation. The ink chapter: essay + four foundation cards
// with KaTeX, plus the turtle's drawings: an elliptical two-body orbit and a small
// vector-field patch in the left margin, gradient-descent contours as the literal
// bridge to the next section, and an annotated equation (underline, circle, arrow
// to a margin note). All geometry generated at build; the engine draws it on scroll.
import 'katex/dist/katex.min.css';
import SectionHeader from '../components/SectionHeader.astro';
import Equation from '../components/Equation.astro';
import { mulberry32, wobbleEllipse } from '../lib/draw.mjs';

const rand = mulberry32(20260712);

const cards = [
  {
    name: 'Mechanics',
    tex: String.raw`S[q] = \int_{t_0}^{t_1} L(q, \dot{q}, t)\, dt`,
    line: 'Variational thinking trained me to turn system behaviour into objectives, constraints, and measurable outcomes.',
  },
  {
    name: 'Linear algebra',
    tex: String.raw`A = U \Sigma V^{\top}`,
    line: 'The geometry behind embeddings, image features, and model representations is often the shortest path to a useful diagnosis.',
  },
  {
    name: 'Probability',
    tex: String.raw`p(\theta \mid x) = \frac{p(x \mid \theta)\, p(\theta)}{p(x)}`,
    line: 'Evaluation is evidence: confidence, uncertainty, and failure cases matter more than a single headline score.',
  },
  {
    name: 'Optimization',
    tex: String.raw`\theta_{t+1} = \theta_t - \eta\, \nabla_{\theta} \mathcal{L}(\theta_t)`,
    line: 'Training is an iterative system: follow the gradient, respect the step size, and inspect what the loss leaves out.',
  },
];

// vector-field patch: 5x5 rotational field, one path per arrow
const arrows: string[] = [];
for (let r = 0; r < 5; r++) {
  for (let c = 0; c < 5; c++) {
    const x = 17 + c * 29, y = 17 + r * 29;
    const dx = -(y - 75), dy = x - 75;
    const m = Math.hypot(dx, dy) || 1;
    const ux = (dx / m) * 11, uy = (dy / m) * 11;
    const x2 = x + ux, y2 = y + uy;
    // shaft + arrowhead in one path
    const hx = -ux * 0.35, hy = -uy * 0.35;
    const px = -uy * 0.28, py = ux * 0.28;
    arrows.push(
      `M ${x.toFixed(1)} ${y.toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)} M ${(x2 + hx + px).toFixed(1)} ${(y2 + hy + py).toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)} L ${(x2 + hx - px).toFixed(1)} ${(y2 + hy - py).toFixed(1)}`
    );
  }
}

// An anisotropic quadratic gives the drawing real optimizer behaviour while the
// hand-wobbled contours keep it in the site's notebook language.
const OPT = { cx: 320, cy: 178, sx: 88, sy: 72 };
const contours = [255, 203, 151, 101, 54].map((rx) =>
  wobbleEllipse(OPT.cx, OPT.cy, rx, rx * 0.55, rand, { wobble: 0.035, rot: -0.2, points: 40 })
);
const toSvg = ([x, y]: [number, number]) => [OPT.cx + x * OPT.sx, OPT.cy - y * OPT.sy] as [number, number];
const simulate = (start: [number, number], rate = 0.14, momentum = 0.68, count = 22) => {
  let [x, y] = start;
  let vx = 0;
  let vy = 0;
  const result: [number, number][] = [[x, y]];
  for (let i = 0; i < count; i++) {
    const gx = 1.1 * x + 0.35 * y;
    const gy = 2.3 * y + 0.35 * x;
    vx = momentum * vx + gx;
    vy = momentum * vy + gy;
    x -= rate * vx;
    y -= rate * vy;
    result.push([x, y]);
  }
  return result;
};
const optimizerSteps = simulate([2.5, -1.55]);
const optimizerSvgSteps = optimizerSteps.map(toSvg);
const descentD = `M ${optimizerSvgSteps.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L ')}`;
const [startX, startY] = optimizerSvgSteps[0];
const [endX, endY] = optimizerSvgSteps.at(-1)!;
---
<section id="foundations" class="section" style="--accent: var(--cobalt)" aria-labelledby="foundations-title">
  <div class="container">
    <!-- margin drawings: the turtle works the left gutter through the ink chapter -->
    <svg class="margin-draw fnd-orbit" viewBox="0 0 160 130" aria-hidden="true">
      <path data-draw class="orbit-path" d={wobbleEllipse(80, 66, 62, 36, rand, { wobble: 0.02, rot: -0.28 })} />
      <circle data-pop class="orbit-focus" cx="62" cy="72" r="5" />
      <circle data-pop class="orbit-body" cx="128" cy="40" r="4" />
      <path data-draw class="orbit-vel" d="M 128 40 l 12 -8" />
    </svg>
    <svg class="margin-draw fnd-field" viewBox="0 0 150 150" aria-hidden="true">
      {arrows.map((d) => <path data-draw class="field-arrow" d={d} />)}
    </svg>

    <SectionHeader num="02" title="Physics &amp; mathematics" headingId="foundations-title" glyphId="foundations" />
    <div class="prose">
      <p>
        I studied physics at the Central University of Kashmir, completing a BSc in 2018
        and an MSc in 2020 with a specialization in theoretical nuclear physics. That
        training shaped how I approach machine learning: define the system, make the
        assumptions visible, and test where the model stops matching reality.
      </p>
      <p>
        Since moving into AI engineering, I have carried that discipline into camera
        systems, diffusion pipelines, LLM evaluation, and the infrastructure that keeps
        them reliable under production load.
      </p>
      <p>
        These four ideas are the bridge between my physics background and the systems I
        build now. They are not decoration; they guide model choice, debugging, and evaluation.
      </p>
      <p class="mono muted edu-line">
        MSc Physics, 2020 · BSc Physics, 2018 · Central University of Kashmir
      </p>
    </div>
    <ul class="cols-2 foundation-grid" role="list">
      {cards.map((c) => (
        <li class="card foundation-card">
          <h3>{c.name}</h3>
          <Equation tex={c.tex} />
          <p class="muted">{c.line}</p>
        </li>
      ))}
    </ul>

    <!-- A working optimizer: drag the start point and compare update rules. -->
    <figure class="fnd-contours optimizer-lab" data-optimizer-lab>
      <div class="optimizer-heading">
        <div>
          <p class="mono optimizer-kicker">explorable objective</p>
          <h3>How an optimizer finds the minimum</h3>
        </div>
        <output class="mono optimizer-status" data-opt-status aria-live="polite">Momentum / 22 updates / loss &lt;0.001</output>
      </div>

      <div class="optimizer-stage">
        <svg viewBox="0 0 640 360" role="img" aria-labelledby="optimizer-title optimizer-desc">
          <title id="optimizer-title">Interactive optimization landscape</title>
          <desc id="optimizer-desc">A momentum optimizer descends an anisotropic quadratic loss. Drag or use the arrow keys on the start point to change its path.</desc>
          <g class="optimizer-grid" aria-hidden="true">
            <path d="M 56 178 H 594 M 320 30 V 326" />
            <path d="M 144 30 V 326 M 232 30 V 326 M 408 30 V 326 M 496 30 V 326 M 56 106 H 594 M 56 250 H 594" />
          </g>
          <g aria-hidden="true">
            {contours.map((d) => <path data-draw class="contour" d={d} />)}
          </g>
          <path class="descent" data-opt-path d={descentD} />
          <g data-opt-steps aria-hidden="true">
            {optimizerSvgSteps.slice(1, -1).map(([x, y], index) => (
              <circle class="descent-dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r={index % 2 === 0 ? 2.5 : 2} />
            ))}
          </g>
          <circle class="optimizer-minimum" cx={OPT.cx} cy={OPT.cy} r="5" aria-hidden="true" />
          <g
            class="optimizer-start"
            data-opt-start
            role="slider"
            tabindex="0"
            aria-label="Optimizer starting point"
            aria-valuemin="-3"
            aria-valuemax="3"
            aria-valuenow="2.5"
            aria-valuetext="x 2.5, y -1.55"
            transform={`translate(${startX.toFixed(1)} ${startY.toFixed(1)})`}
          >
            <circle class="optimizer-start-halo" r="15" />
            <circle class="optimizer-start-dot" r="6" />
          </g>
          <g class="optimizer-end" data-opt-end transform={`translate(${endX.toFixed(1)} ${endY.toFixed(1)})`} aria-hidden="true">
            <circle class="optimizer-end-halo" r="7" />
            <circle class="optimizer-end-dot" r="3" />
          </g>
          <text class="optimizer-axis-label" x="558" y="169">&#952;&#8321;</text>
          <text class="optimizer-axis-label" x="329" y="43">&#952;&#8322;</text>
        </svg>
      </div>

      <div class="optimizer-controls">
        <fieldset class="optimizer-modes">
          <legend class="mono">update rule</legend>
          <div class="segmented-control" data-opt-modes>
            <label><input type="radio" name="optimizer" value="sgd" disabled /> <span>SGD</span></label>
            <label><input type="radio" name="optimizer" value="momentum" checked disabled /> <span>Momentum</span></label>
          </div>
        </fieldset>
        <label class="optimizer-range mono">
          <span>learning rate <output data-opt-rate>0.14</output></span>
          <input data-opt-rate-input type="range" min="0.04" max="0.28" step="0.01" value="0.14" disabled />
        </label>
        <label class="optimizer-range mono" data-opt-momentum-control>
          <span>momentum <output data-opt-momentum>0.68</output></span>
          <input data-opt-momentum-input type="range" min="0" max="0.9" step="0.01" value="0.68" disabled />
        </label>
        <button class="optimizer-reset" type="button" data-opt-reset aria-label="Reset optimizer" title="Reset optimizer" disabled>&#8634;</button>
      </div>
      <figcaption class="mono muted optimizer-caption">
        <i>L</i>(&theta;) = 0.55&theta;<sub>1</sub><sup>2</sup> + 1.15&theta;<sub>2</sub><sup>2</sup> + 0.35&theta;<sub>1</sub>&theta;<sub>2</sub>.
        The same objective can converge, oscillate, or diverge as the update rule and step size change.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .fnd-orbit { top: 9%; }
  .fnd-field { top: 42%; }
  .orbit-path { stroke: var(--ink); stroke-width: 1.75; fill: none; }
  .orbit-focus { fill: var(--cobalt); }
  .orbit-body { fill: none; stroke: var(--ink); stroke-width: 1.75; }
  .orbit-vel { stroke: var(--ink-soft); stroke-width: 1.5; fill: none; stroke-linecap: round; }
  .field-arrow { stroke: var(--ink-soft); stroke-width: 1.4; fill: none; stroke-linecap: round; opacity: 0.8; }

  .edu-line { margin-top: var(--s-4); }
  .foundation-grid { margin-top: var(--s-7); padding: 0; list-style: none; }
  .foundation-card h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .foundation-card .muted { font-size: var(--step-0); }

  .fnd-contours {
    margin: var(--s-8) auto calc(-1 * var(--s-6));
  }
  .optimizer-lab {
    max-width: 920px;
    border-block: 1px solid var(--line);
    padding-block: var(--s-5);
  }
  .optimizer-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-3);
  }
  .optimizer-heading h3 { font-size: 1.25rem; }
  .optimizer-kicker {
    color: var(--cobalt);
    margin-bottom: var(--s-1);
  }
  .optimizer-status {
    color: var(--ink-soft);
    text-align: right;
  }
  .optimizer-stage {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--cobalt) 3%, var(--paper));
    overflow: hidden;
  }
  .optimizer-stage svg {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    overflow: visible;
    touch-action: none;
  }
  .optimizer-grid path {
    stroke: color-mix(in srgb, var(--ink-soft) 18%, transparent);
    stroke-width: 1;
    fill: none;
  }
  .optimizer-grid path + path { stroke-dasharray: 2 8; }
  .contour {
    stroke: var(--ink-soft);
    stroke-width: 1.4;
    fill: none;
    opacity: 0.58;
  }
  .descent {
    stroke: var(--ink);
    stroke-width: 2.2;
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .descent-dot { fill: var(--cobalt); }
  .optimizer-minimum {
    fill: var(--paper);
    stroke: var(--cobalt);
    stroke-width: 2;
  }
  .optimizer-start { cursor: grab; }
  .optimizer-start:focus { outline: none; }
  .optimizer-start:active { cursor: grabbing; }
  .optimizer-start-halo {
    fill: color-mix(in srgb, var(--cobalt) 10%, transparent);
    stroke: color-mix(in srgb, var(--cobalt) 35%, transparent);
    stroke-width: 1;
  }
  .optimizer-start-dot {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2.2;
  }
  .optimizer-start:focus-visible .optimizer-start-halo {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .optimizer-end-halo {
    fill: color-mix(in srgb, var(--cobalt) 12%, transparent);
    stroke: color-mix(in srgb, var(--cobalt) 38%, transparent);
    stroke-width: 1;
  }
  .optimizer-end-dot { fill: var(--ink); }
  .optimizer-axis-label {
    fill: var(--ink-soft);
    font: 11px var(--font-mono);
    letter-spacing: 0;
  }
  .optimizer-controls {
    display: grid;
    grid-template-columns: auto minmax(140px, 1fr) minmax(140px, 1fr) 44px;
    gap: var(--s-4);
    align-items: end;
    margin-top: var(--s-4);
  }
  .optimizer-modes { border: 0; padding: 0; min-width: 0; }
  .optimizer-modes legend,
  .optimizer-range > span {
    display: block;
    margin-bottom: var(--s-2);
    color: var(--ink-soft);
  }
  .segmented-control {
    display: inline-grid;
    grid-auto-flow: column;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .segmented-control label { position: relative; cursor: pointer; }
  .segmented-control label + label { border-left: 1px solid color-mix(in srgb, var(--ink) 28%, transparent); }
  .segmented-control input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .segmented-control span {
    display: grid;
    min-height: 42px;
    padding: 8px 14px;
    place-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: var(--paper);
  }
  .segmented-control input:checked + span {
    color: var(--paper);
    background: var(--ink);
  }
  .segmented-control input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }
  .optimizer-range input {
    display: block;
    width: 100%;
    accent-color: var(--cobalt);
  }
  .optimizer-range.is-disabled { opacity: 0.45; }
  .optimizer-reset {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
  }
  .optimizer-reset:hover { background: var(--paper-deep); }
  .optimizer-caption {
    margin-top: var(--s-3);
    font-style: normal;
  }
  .optimizer-caption sub,
  .optimizer-caption sup { font-size: 0.75em; }

  @media (max-width: 719px) {
    .optimizer-heading { align-items: start; flex-direction: column; }
    .optimizer-heading h3 { font-size: 1.125rem; }
    .optimizer-status { text-align: left; }
    .optimizer-controls { grid-template-columns: 1fr 44px; }
    .optimizer-modes { grid-column: 1 / -1; }
    .optimizer-range { grid-column: 1 / -1; }
    .optimizer-reset { grid-column: 2; grid-row: 4; }
    .optimizer-controls,
    .optimizer-caption { margin-right: 36px; }
    .optimizer-stage svg { aspect-ratio: 4 / 3; }
    .optimizer-axis-label { font-size: 20px; }
  }
</style>
