---
// §10.2 — Physics & math foundation. The ink chapter: essay + four foundation cards with KaTeX.
// Turtle drawings (orbit, vector field, gradient-descent contours) arrive in Phase 3.
import 'katex/dist/katex.min.css';
import SectionHeader from '../components/SectionHeader.astro';
import Equation from '../components/Equation.astro';

const cards = [
  {
    name: 'Mechanics',
    tex: String.raw`S[q] = \int_{t_0}^{t_1} L(q, \dot{q}, t)\, dt`,
    line: 'Dynamics as optimization: the path taken is the one that extremizes a functional.',
  },
  {
    name: 'Linear algebra',
    tex: String.raw`A = U \Sigma V^{\top}`,
    line: 'Every dataset is a geometry; the spectrum tells you what the data can support.',
  },
  {
    name: 'Probability',
    tex: String.raw`p(\theta \mid x) = \frac{p(x \mid \theta)\, p(\theta)}{p(x)}`,
    line: 'Uncertainty is a first-class quantity, updated honestly as evidence arrives.',
  },
  {
    name: 'Optimization',
    tex: String.raw`\theta_{t+1} = \theta_t - \eta\, \nabla_{\theta} \mathcal{L}(\theta_t)`,
    line: 'How learning actually happens: follow the gradient, respect the step size.',
  },
];
---
<section id="foundations" class="section" style="--accent: var(--cobalt)" aria-labelledby="foundations-title">
  <div class="container">
    <SectionHeader num="02" title="Physics &amp; mathematics" headingId="foundations-title" glyphId="foundations" />
    <!-- PLACEHOLDER: personalize this narrative to the owner's actual background -->
    <div class="prose">
      <p>
        My route into machine learning ran through classical mechanics and linear algebra,
        and it shows in how I work: I want the model class written down, the assumptions
        explicit, and the failure modes named before anything ships.
      </p>
      <p>
        Physics teaches a specific kind of taste — prefer the smallest system that still
        explains the data, and treat every metric as a measurement with error bars rather
        than a scoreboard.
      </p>
      <p>
        The four tools below do most of the work. Everything later on this page — vision
        models, generative systems, production pipelines — is these four, applied with care.
      </p>
    </div>
    <ul class="cols-2 foundation-grid" role="list">
      {cards.map((c) => (
        <li class="card foundation-card">
          <h3>{c.name}</h3>
          <Equation tex={c.tex} />
          <p class="muted">{c.line}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .foundation-grid {
    margin-top: var(--s-7);
    padding: 0;
    list-style: none;
  }
  .foundation-card h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--ink-soft);
  }
  .foundation-card .muted { font-size: var(--step-0); }
</style>
