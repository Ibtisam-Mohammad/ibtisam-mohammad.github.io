---
// §10.2 — Physics & math foundation. The ink chapter: essay + four foundation cards
// with KaTeX, plus the turtle's drawings: an elliptical two-body orbit and a small
// vector-field patch in the left margin, gradient-descent contours as the literal
// bridge to the next section, and an annotated equation (underline, circle, arrow
// to a margin note). All geometry generated at build; the engine draws it on scroll.
import 'katex/dist/katex.min.css';
import SectionHeader from '../components/SectionHeader.astro';
import Equation from '../components/Equation.astro';
import { mulberry32, wobbleEllipse } from '../lib/draw.mjs';

const rand = mulberry32(20260712);

const cards = [
  {
    name: 'Mechanics',
    tex: String.raw`S[q] = \int_{t_0}^{t_1} L(q, \dot{q}, t)\, dt`,
    line: 'Dynamics as optimization: the path taken is the one that extremizes a functional.',
  },
  {
    name: 'Linear algebra',
    tex: String.raw`A = U \Sigma V^{\top}`,
    line: 'Every dataset is a geometry; the spectrum tells you what the data can support.',
  },
  {
    name: 'Probability',
    tex: String.raw`p(\theta \mid x) = \frac{p(x \mid \theta)\, p(\theta)}{p(x)}`,
    line: 'Uncertainty is a first-class quantity, updated honestly as evidence arrives.',
  },
  {
    name: 'Optimization',
    tex: String.raw`\theta_{t+1} = \theta_t - \eta\, \nabla_{\theta} \mathcal{L}(\theta_t)`,
    line: 'How learning actually happens: follow the gradient, respect the step size.',
    annotated: true,
  },
];

// vector-field patch: 5x5 rotational field, one path per arrow
const arrows: string[] = [];
for (let r = 0; r < 5; r++) {
  for (let c = 0; c < 5; c++) {
    const x = 17 + c * 29, y = 17 + r * 29;
    const dx = -(y - 75), dy = x - 75;
    const m = Math.hypot(dx, dy) || 1;
    const ux = (dx / m) * 11, uy = (dy / m) * 11;
    const x2 = x + ux, y2 = y + uy;
    // shaft + arrowhead in one path
    const hx = -ux * 0.35, hy = -uy * 0.35;
    const px = -uy * 0.28, py = ux * 0.28;
    arrows.push(
      `M ${x.toFixed(1)} ${y.toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)} M ${(x2 + hx + px).toFixed(1)} ${(y2 + hy + py).toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)} L ${(x2 + hx - px).toFixed(1)} ${(y2 + hy - py).toFixed(1)}`
    );
  }
}

// contour rings + a gradient-descent path stepping into the minimum
const CX = 240, CY = 148;
const contours = [150, 112, 76, 42].map((rx, i) =>
  wobbleEllipse(CX, CY, rx, rx * 0.6, rand, { wobble: 0.045, rot: -0.2, points: 34 })
);
let px2 = 408, py2 = 46;
const steps: [number, number][] = [[px2, py2]];
for (let k = 0; k < 8; k++) {
  const toC = [CX - px2, CY - py2];
  const m = Math.hypot(...toC) || 1;
  const perp = (k % 2 ? 1 : -1) * (26 * (1 - k / 9));
  px2 += (toC[0] / m) * m * 0.3 + (-toC[1] / m) * perp;
  py2 += (toC[1] / m) * m * 0.3 + (toC[0] / m) * perp;
  steps.push([px2, py2]);
}
steps.push([CX, CY]);
const descentD = `M ${steps.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L ')}`;
---
<section id="foundations" class="section" style="--accent: var(--cobalt)" aria-labelledby="foundations-title">
  <div class="container">
    <!-- margin drawings: the turtle works the left gutter through the ink chapter -->
    <svg class="margin-draw fnd-orbit" viewBox="0 0 160 130" aria-hidden="true">
      <path data-draw class="orbit-path" d={wobbleEllipse(80, 66, 62, 36, rand, { wobble: 0.02, rot: -0.28 })} />
      <circle data-pop class="orbit-focus" cx="62" cy="72" r="5" />
      <circle data-pop class="orbit-body" cx="128" cy="40" r="4" />
      <path data-draw class="orbit-vel" d="M 128 40 l 12 -8" />
    </svg>
    <svg class="margin-draw fnd-field" viewBox="0 0 150 150" aria-hidden="true">
      {arrows.map((d) => <path data-draw class="field-arrow" d={d} />)}
    </svg>

    <SectionHeader num="02" title="Physics &amp; mathematics" headingId="foundations-title" glyphId="foundations" />
    <div class="prose">
      <p>
        My route into machine learning ran through theoretical nuclear physics — a master's
        spent on systems nobody can observe directly, where every claim rides on the
        mathematics being right. It shows in how I work: I want the model class written
        down, the assumptions explicit, and the failure modes named before anything ships.
      </p>
      <p>
        Physics teaches a specific kind of taste — prefer the smallest system that still
        explains the data, and treat every metric as a measurement with error bars rather
        than a scoreboard.
      </p>
      <p>
        The four tools below do most of the work. Everything later on this page — vision
        models, generative systems, production pipelines — is these four, applied with care.
      </p>
      <p class="mono muted edu-line">
        MSc Physics, Central University of Kashmir · theoretical nuclear physics
      </p>
    </div>
    <ul class="cols-2 foundation-grid" role="list">
      {cards.map((c) => (
        <li class="card foundation-card">
          <h3>{c.name}</h3>
          {c.annotated ? (
            <div class="eq-wrap">
              <span class="eq-note mono" aria-hidden="true">respect the step size</span>
              <Equation tex={c.tex} />
              <svg class="eq-annotate" viewBox="0 0 340 100" aria-hidden="true">
                <path data-draw class="ann-marker" d="M 168 74 C 210 82, 272 82, 320 74" />
                <ellipse data-draw class="ann-ring" cx="160" cy="52" rx="18" ry="15" />
                <path data-draw class="ann-arrow" d="M 172 38 C 204 16, 244 10, 284 14 M 284 14 l -11 -5 M 284 14 l -12 4" />
              </svg>
            </div>
          ) : (
            <Equation tex={c.tex} />
          )}
          <p class="muted">{c.line}</p>
        </li>
      ))}
    </ul>

    <!-- the literal bridge to what follows: contours, and a path stepping down them -->
    <figure class="fnd-contours">
      <svg viewBox="0 0 480 280" aria-hidden="true">
        {contours.map((d) => <path data-draw class="contour" d={d} />)}
        <path data-draw class="descent" d={descentD} />
        {steps.map(([x, y], i) => <circle data-pop class="descent-dot" cx={x.toFixed(1)} cy={y.toFixed(1)} r={i === steps.length - 1 ? 5 : 3} />)}
      </svg>
      <figcaption class="visually-hidden">Contour lines with a gradient-descent path stepping into the minimum.</figcaption>
    </figure>
  </div>
</section>

<style>
  .fnd-orbit { top: 9%; }
  .fnd-field { top: 42%; }
  .orbit-path { stroke: var(--ink); stroke-width: 1.75; fill: none; }
  .orbit-focus { fill: var(--cobalt); }
  .orbit-body { fill: none; stroke: var(--ink); stroke-width: 1.75; }
  .orbit-vel { stroke: var(--ink-soft); stroke-width: 1.5; fill: none; stroke-linecap: round; }
  .field-arrow { stroke: var(--ink-soft); stroke-width: 1.4; fill: none; stroke-linecap: round; opacity: 0.8; }

  .edu-line { margin-top: var(--s-4); }
  .foundation-grid { margin-top: var(--s-7); padding: 0; list-style: none; }
  .foundation-card h3 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .foundation-card .muted { font-size: var(--step-0); }

  .eq-wrap { position: relative; }
  .eq-annotate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }
  .ann-marker { stroke: var(--marker); stroke-width: 7; stroke-linecap: round; fill: none; opacity: 0.75; }
  .ann-ring { stroke: var(--ink); stroke-width: 1.75; fill: none; }
  .ann-arrow { stroke: var(--ink-soft); stroke-width: 1.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .eq-note {
    position: absolute;
    top: -4px;
    right: 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .fnd-contours {
    margin: var(--s-8) auto calc(-1 * var(--s-6));
    max-width: 480px;
  }
  .fnd-contours svg { width: 100%; height: auto; overflow: visible; }
  .contour { stroke: var(--ink-soft); stroke-width: 1.4; fill: none; opacity: 0.7; }
  .descent { stroke: var(--ink); stroke-width: 2; fill: none; stroke-linejoin: round; }
  .descent-dot { fill: var(--cobalt); }
</style>
