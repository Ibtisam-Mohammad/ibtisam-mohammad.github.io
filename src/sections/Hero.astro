---
// §10.1 — Hero, SIGNATURE 1 of 4. The turtle enters pen-up, drops the pen, draws light
// coordinate axes, then a sine wave that resolves into the underline of the name, and
// plants a single cobalt dot at the origin. All geometry is generated at build time;
// the finished drawing is the no-JS/reduced-motion default, the engine rewinds it.
//
// Decision (DESIGN.md): the h1 stays real text at all times — identity must land in
// 5 seconds and "scanning wins" (§1). Stroke-reveal headings apply from §10.5 on.

const X0 = 14;      // origin x (viewBox units)
const AXIS_Y = 18;  // the x-axis doubles as the name underline
const AMP = 16;
const SINE_END = 560;

let sineD = `M ${X0} ${AXIS_Y}`;
for (let x = X0 + 4; x <= SINE_END; x += 4) {
  const t = (x - X0) / (SINE_END - X0);
  const a = AMP * Math.pow(1 - t, 1.6);
  const y = AXIS_Y - Math.sin((x - X0) / 26) * a;
  sineD += ` L ${x} ${y.toFixed(2)}`;
}
sineD += ` L 588 ${AXIS_Y}`;

// light axes with plotter ticks
const xAxisD = `M 6 ${AXIS_Y} H 985 M 200 ${AXIS_Y - 3} V ${AXIS_Y + 3} M 400 ${AXIS_Y - 3} V ${AXIS_Y + 3} M 600 ${AXIS_Y - 3} V ${AXIS_Y + 3} M 800 ${AXIS_Y - 3} V ${AXIS_Y + 3}`;
const yAxisD = `M ${X0} 2 V 112 M ${X0 - 3} 40 H ${X0 + 3} M ${X0 - 3} 70 H ${X0 + 3} M ${X0 - 3} 100 H ${X0 + 3}`;
---
<section id="hero" class="section hero" style="--accent: var(--cobalt)">
  <div class="hero-pin">
    <div class="container">
    <h1 class="hero-name">
      <span class="duality-name" data-duality-name>
        <span class="duality-name-label" data-duality-label>Ibtisam</span>
        <canvas class="duality-name-canvas" data-duality-canvas aria-hidden="true"></canvas>
      </span>
      <!-- full name + role stay in the h1 for search, screen readers, and name recall -->
      <span class="visually-hidden"> Mohammad — AI engineer</span>
    </h1>
    <svg class="hero-scene" viewBox="0 0 1000 120" aria-hidden="true">
      <path data-part="axis" data-draw d={yAxisD} class="axis" />
      <path data-part="axis" data-draw d={xAxisD} class="axis" />
      <path data-part="sine" data-draw d={sineD} class="sine" />
      <circle data-part="dot" cx={X0} cy={AXIS_Y} r="5.5" class="origin-dot" />
    </svg>
    <p class="lede thesis">AI engineer and physicist building systems that work beyond the notebook.</p>
    <p class="mono muted roles">Computer vision &middot; generative AI &middot; agents &middot; MLOps</p>
    <!-- the strongest shipped outcomes, surfaced before anything else asks for scroll -->
    <p class="hero-proof mono" aria-label="Selected production results">
      <strong>~25&nbsp;s&nbsp;&rarr;&nbsp;&lt;1&nbsp;s</strong> API latency &middot;
      <strong>&minus;95%</strong> errors under load &middot;
      <strong>~1&nbsp;s</strong> production face swap &middot;
      <strong>3&nbsp;yrs</strong> shipping AI systems
    </p>
    <p class="hero-avail mono">
      <span class="avail-dot" aria-hidden="true"></span>
      Open to full-time roles &amp; contract work &middot; remote-friendly &middot; UTC+05:30
    </p>
    <div class="oss-proof">
      <p class="oss-copy">
        <span class="mono oss-kicker">Open source</span>
        I curate <a class="oss-title" href="/notes/open-resources-defence-systems/"><strong>Awesome Defence</strong></a>,
        a public map of open tools and research across autonomy, sensing, geospatial
        intelligence, and simulation.
      </p>
      <a
        class="mono oss-repo"
        href="https://github.com/Ibtisam-Mohammad/awesome-defense"
      >my most-starred repository &middot; GitHub &#8599;</a>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href="#work">View work</a>
      <a class="btn btn-ghost" href="mailto:ibtisam115@gmail.com">Email me</a>
      <a class="btn btn-ghost" href="/resume.pdf" target="_blank" rel="noopener">View résumé</a>
    </div>
    </div>
  </div>
</section>

<style>
  /* the hero holds a compact scroll stage; content pins (native sticky, no hijacking)
     while the turtle draws, then releases. Reduced-motion/no-JS: no pin needed,
     but sticky is harmless there — the drawing is already finished. */
  .hero {
    min-height: 150svh;
    padding-block: 0;
  }
  .hero-pin {
    position: sticky;
    top: 64px;
    min-height: calc(100svh - 64px);
    display: grid;
    align-items: center;
    padding-block: var(--s-6);
  }
  .hero-scene {
    width: 100%;
    height: auto;
    margin-top: 0; /* svg scales with width: only pull it up where it renders large */
    overflow: visible;
  }
  .hero-name { width: fit-content; }
  .duality-name {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
  .duality-name-label {
    display: block;
    will-change: opacity;
  }
  .duality-name-canvas {
    position: absolute;
    z-index: 1;
    max-width: none;
    pointer-events: none;
    opacity: 0;
  }
  @media (min-width: 720px) {
    .hero-scene { margin-top: -12px; } /* underline hugs the name's baseline */
  }
  .axis {
    stroke: var(--ink-soft);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
    opacity: 0.45;
  }
  .sine {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }
  .origin-dot {
    fill: var(--cobalt);
    transform-box: fill-box;
    transform-origin: center;
  }
  .thesis {
    margin-top: var(--s-5);
    font-size: clamp(1.25rem, 1.14rem + 0.5vw, 1.625rem);
    max-width: 34ch;
  }
  .roles { margin-top: var(--s-4); }
  .hero-proof {
    margin-top: var(--s-4);
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .hero-proof strong {
    color: var(--ink);
    font-weight: 500;
  }
  .hero-avail {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-3);
    color: var(--ink-soft);
  }
  .avail-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--leaf) 18%, transparent);
  }
  .oss-proof {
    max-width: 68ch;
    margin-top: var(--s-5);
    padding-left: var(--s-4);
    border-left: 2px solid var(--cobalt);
  }
  .oss-copy {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
  }
  .oss-kicker {
    margin-right: var(--s-2);
    color: var(--cobalt);
    font-size: var(--step--1);
  }
  .oss-title { color: var(--ink); }
  .oss-repo {
    display: inline-block;
    margin-top: var(--s-2);
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-underline-offset: 3px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  @media (max-width: 719px) {
    .hero { min-height: 138svh; }
    .oss-proof {
      margin-top: var(--s-4);
      padding-left: var(--s-3);
    }
  }
</style>
