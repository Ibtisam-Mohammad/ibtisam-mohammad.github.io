---
import '../styles/tokens.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TurtleOverlay from '../components/TurtleOverlay.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  /** error pages: emit noindex and no canonical/og:url (a 404 has no canonical URL) */
  noindex?: boolean;
}
const {
  title = 'Ibtisam Mohammad | AI Engineer and Physicist',
  description = 'Portfolio of Ibtisam Mohammad, an AI engineer and physicist building production computer vision, generative AI, agentic workflows, and MLOps systems.',
  ogType = 'website',
  structuredData,
  noindex = false,
} = Astro.props;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCF8EF" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
      </>
    )}
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Ibtisam Mohammad — field notes" href={new URL('/rss.xml', Astro.site)} />
    {serializedStructuredData && (
      <script type="application/ld+json" set:html={serializedStructuredData} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- classes gate the animation system: no JS -> finished states in markup;
         reduced motion -> `js` without `anim`, so no scroll-scrubbed motion ever runs -->
    <script is:inline>
      var de = document.documentElement;
      de.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) de.classList.add('anim');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <TurtleOverlay />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
