---
// Footer closes on the portfolio's central idea — and, on every page, a working
// contact path: the maximum scroll depth is never a dead end.
import { BOOKING, EMAIL_HREF, GITHUB, LINKEDIN, RESUME } from '../data/contact';
---
<footer class="footer">
  <div class="container footer-inner">
    <p class="mono muted">drawn from first principles.</p>
    <p class="mono footer-links">
      {BOOKING && (
        <>
          <a href={BOOKING} target="_blank" rel="noopener">book a call</a>
          <span class="muted" aria-hidden="true"> · </span>
        </>
      )}
      <a href={EMAIL_HREF}>email</a>
      <span class="muted" aria-hidden="true"> · </span>
      <a href={GITHUB}>github</a>
      <span class="muted" aria-hidden="true"> · </span>
      <a href={LINKEDIN}>linkedin</a>
      <span class="muted" aria-hidden="true"> · </span>
      <a href={RESUME} target="_blank" rel="noopener">résumé</a>
    </p>
    <p class="mono muted">© 2026 Ibtisam Mohammad</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: var(--s-7) var(--s-8);
    margin-top: var(--s-8);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
  }
</style>
