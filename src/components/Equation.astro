---
// KaTeX rendered at build time (plan.md §6/§14). throwOnError so a bad equation fails the build.
// Default htmlAndMathml output keeps the hidden MathML for screen readers.
import katex from 'katex';

interface Props {
  tex: string;
  display?: boolean;
}
const { tex, display = true } = Astro.props;
const html = katex.renderToString(tex, { displayMode: display, throwOnError: true });
---
{display ? <div class="equation" set:html={html} /> : <span set:html={html} />}
