---
// Stroke-reveal heading (plan.md §6, drawing law rule 2): real text is always in the
// DOM. With JS + motion (html.anim), the visible treatment is the letter outlines
// drawing in, layered over visually-hidden real text. Reduced-motion and no-JS users
// get the plainly set heading — the SVG never shows.
import headings from '../assets/generated/headings.json';

interface Props {
  glyphId: string;
  headingId: string;
}
const { glyphId, headingId } = Astro.props;
const h = (headings as Record<string, { text: string; width: number; height: number; paths: string[] }>)[glyphId];
if (!h) throw new Error(`StrokeHeading: no glyphs generated for "${glyphId}" — run scripts/gen_heading_paths.py`);
---
<h2 id={headingId} class="stroke-heading">
  <span class="sh-real">{h.text}</span>
  <svg
    class="sh-svg"
    viewBox={`0 0 ${h.width} ${h.height}`}
    style={`aspect-ratio: ${h.width} / ${h.height};`}
    aria-hidden="true"
  >
    {h.paths.map((d: string) => <path data-draw d={d} />)}
  </svg>
</h2>
