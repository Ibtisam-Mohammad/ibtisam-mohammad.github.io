---
// Sticky top bar (plan.md §9): mark + name left; Work · Notes · Contact; persistent Résumé button.
// The 1px scroll-progress hairline arrives with the scroll engine in Phase 2.
import TurtleMark from './TurtleMark.astro';
---
<header class="topbar">
  <div class="container topbar-inner">
    <!-- aria-label keeps the accessible name when .brand-name is hidden at narrow widths -->
    <a class="brand" href="/" aria-label="Ibtisam Mohammad — home">
      <TurtleMark size={26} />
      <span class="brand-name" aria-hidden="true">Ibtisam</span>
    </a>
    <nav aria-label="Site">
      <ul class="topnav">
        <li><a href="/#work">Work</a></li>
        <li class="nav-notes"><a href="/#notes">Notes</a></li>
        <li><a href="/#contact">Contact</a></li>
        <li>
          <a class="btn btn-primary btn-bar" href="/resume.pdf" download aria-label="Download résumé">
            <span class="resume-long">Résumé</span><span class="resume-short" aria-hidden="true">CV</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div id="progress-hairline" aria-hidden="true"></div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-bar);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  /* scroll-progress hairline, tinted to the current section's accent (plan.md §9) */
  #progress-hairline {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--cobalt);
    transform: scaleX(0);
    transform-origin: 0 50%;
    display: none;
  }
  :global(html.anim) #progress-hairline { display: block; }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--ink);
    padding-block: var(--s-2);
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
  }
  .topnav {
    display: flex;
    align-items: center;
    gap: clamp(var(--s-4), 2.5vw, var(--s-6));
    list-style: none;
    padding: 0;
  }
  .topnav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--ink);
    padding-block: var(--s-3);
  }
  .topnav a:not(.btn):hover { text-decoration: underline; text-underline-offset: 4px; }
  .btn-bar { padding: 6px 16px; font-size: 0.9375rem; }
  .resume-short { display: none; }

  @media (max-width: 479px) {
    .brand-name { display: none; }
    .topbar-inner { gap: var(--s-2); }
    .topnav { gap: var(--s-1); }
    .nav-notes { display: none; }
  }
  @media (max-width: 359px) {
    .resume-long { display: none; }
    .resume-short { display: inline; }
    .btn-bar { min-width: 48px; padding-inline: 12px; }
  }
</style>
