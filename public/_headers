# Static-hosting caching headers (Netlify format; see README for other hosts).
# Hashed and versioned assets are immutable; HTML revalidates.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=604800

/img/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate
